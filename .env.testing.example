APP_NAME="Inertia React Starter"
APP_ENV=testing
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

# Generate APP_KEY after copying this file to .env.testing.
# php artisan key:generate --env=testing

BCRYPT_ROUNDS=4

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=debug

DB_TESTING=true

# Safe default. Feature tests use this connection and may refresh it.
TEST_DB_CONNECTION=sqlite
TEST_DB_DATABASE=:memory:

# For MySQL or MariaDB, replace the values above with a dedicated database.
# TEST_DB_CONNECTION=mysql
# TEST_DB_HOST=127.0.0.1
# TEST_DB_PORT=3306
# TEST_DB_DATABASE=laravel_testing
# TEST_DB_USERNAME=root
# TEST_DB_PASSWORD=

# For PostgreSQL, use a dedicated database or schema.
# TEST_DB_CONNECTION=pgsql
# TEST_DB_HOST=127.0.0.1
# TEST_DB_PORT=5432
# TEST_DB_DATABASE=laravel_testing
# TEST_DB_USERNAME=postgres
# TEST_DB_PASSWORD=
# TEST_DB_SEARCH_PATH=public

# For SQL Server, use a dedicated database.
# TEST_DB_CONNECTION=sqlsrv
# TEST_DB_HOST=127.0.0.1
# TEST_DB_PORT=1433
# TEST_DB_DATABASE=laravel_testing
# TEST_DB_USERNAME=sa
# TEST_DB_PASSWORD=

BROADCAST_CONNECTION=null
CACHE_STORE=array
MAIL_MAILER=array
QUEUE_CONNECTION=sync
SESSION_DRIVER=array
